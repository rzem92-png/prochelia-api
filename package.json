{
  "name": "prochelia-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --check src/index.js && node --check src/v7.js && node --check src/supra-intelligence.js && node --check src/supra-orchestrator.js",
    "test:supra": "node --test tests/supra-*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:worker": "wrangler deploy --dry-run",
    "check:worker:preview": "wrangler deploy --dry-run --config wrangler.preview.jsonc",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
