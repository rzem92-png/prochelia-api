{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prochelia-api-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "preview",
    "CORS_ORIGIN": "https://feat-supra-control-center-v1.prochelia.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prochelia-preview-eu-2026-11-17",
      "database_id": "e3cf167c-37e1-4d72-9ac6-b3e27c14b97f"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
