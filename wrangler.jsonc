{
  "name": "prochelia-api-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prochelia-preview-db",
      "database_id": "6adb95e5-e542-4bec-9008-fbea01042305"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "prochelia-preview-backups"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "prochelia-preview-db",
        "database_id": "6adb95e5-e542-4bec-9008-fbea01042305"
      }
    ],
    "r2_buckets": [
      {
        "binding": "BACKUP_BUCKET",
        "bucket_name": "prochelia-preview-backups"
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
